# Supabase Project Settings > API. The browser never talks to Supabase directly;
# only the server uses the project URL and the service_role (or secret) key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Never prefix server secrets with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Opens the referee link (/referee#key=...) and signs sessions. Changing it signs everyone out.
REFEREE_KEY=your_long_random_referee_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your_openrouter_api_key_here
LLM_MODELS=qwen/qwen3.8-27b:free,google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free
CRON_SECRET=your_cron_secret_here
# Leave blank for local development; set your exact HTTPS origin on Vercel.
APP_URL=
# Local development automatically falls back to demo without Supabase.
# Production requires credentials unless this is explicitly true.
DEMO_MODE=false
